# ============================================================
# Prompt Injection Detector -- Environment Variables EXAMPLE
# ============================================================
# Copy to .env and edit. NEVER commit .env.
#
# Detection policy:
#   Auto -> Gemini (primary) -> offline evidence (fallback)
#        -> Ollama Cloud (last resort when configured)
#
# Offline rules, structural forensics, decoding, and entropy detection always
# run and need no key or network access. Local Ollama is NOT used by Auto or
# the web UI; it is available only through explicit `--provider ollama` on the
# CLI for backwards compatibility.

# --- Gemini: primary semantic judge ---
# Get a key at: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.5-flash-lite

# --- Ollama Cloud: last-resort semantic judge ---
# Requires an ollama.com API key. Used only when Gemini is missing or fails.
# OLLAMA_API_KEY=your-ollama-cloud-key-here
# OLLAMA_CLOUD_MODEL=gemma4:31b
# OLLAMA_BASE_URL=https://ollama.com

# --- Local Ollama: explicit CLI only (`--provider ollama`) ---
# These values are ignored by Auto and by the web UI.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
# 4096 keeps the model on the GPU. Larger contexts can take 10x longer.
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT=120

# Maximum semantic judge calls per document (0-50).
MAX_JUDGES=8

# --- Optional OpenAI-compatible judges (explicit CLI only) ---
# Not part of the Auto chain. Select with --provider groq|openrouter|cerebras.
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# CEREBRAS_API_KEY=

# --- Web server ---
# PORT=5001
# FLASK_DEBUG=0
# APP_VERSION=1.0.0
