# ============================================================
# Prompt Injection Detector -- Environment Variables EXAMPLE
# ============================================================
# Copy this file to .env and fill in your keys.
# NEVER commit .env to version control.

# --- Google Gemini API Key (free tier) ---
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# --- Gemini model to use for the LLM judge (L3 layer) ---
# Free options: gemini-2.5-flash-lite  |  gemini-2.0-flash  |  gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Max LLM judge calls per file (quota guard) ---
MAX_JUDGES=8

